{
  "@context": {
    "coverage": "https://ns.cascadeprotocol.org/coverage/v1#",
    "cascade": "https://ns.cascadeprotocol.org/core/v1#",
    "fhir": "http://hl7.org/fhir/",
    "sct": "http://snomed.info/sct/",
    "loinc": "http://loinc.org/rdf#",
    "ucum": "http://unitsofmeasure.org/",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",

    "InsurancePlan": "coverage:InsurancePlan",
    "Deductible": "coverage:Deductible",
    "CopaySchedule": "coverage:CopaySchedule",

    "coverageProviderName": {
      "@id": "coverage:providerName",
      "@type": "xsd:string"
    },
    "coverageMemberId": {
      "@id": "coverage:memberId",
      "@type": "xsd:string"
    },
    "coverageGroupNumber": {
      "@id": "coverage:groupNumber",
      "@type": "xsd:string"
    },
    "coveragePlanName": {
      "@id": "coverage:planName",
      "@type": "xsd:string"
    },
    "coveragePlanType": {
      "@id": "coverage:planType",
      "@type": "xsd:string"
    },
    "coverageCoverageType": {
      "@id": "coverage:coverageType",
      "@type": "xsd:string"
    },
    "coverageStatus": {
      "@id": "coverage:status",
      "@type": "xsd:string"
    },
    "effectiveStart": {
      "@id": "coverage:effectiveStart",
      "@type": "xsd:date"
    },
    "effectiveEnd": {
      "@id": "coverage:effectiveEnd",
      "@type": "xsd:date"
    },
    "coverageSubscriberId": {
      "@id": "coverage:subscriberId",
      "@type": "xsd:string"
    },
    "subscriberName": {
      "@id": "coverage:subscriberName",
      "@type": "xsd:string"
    },
    "subscriberRelationship": {
      "@id": "coverage:subscriberRelationship",
      "@type": "xsd:string"
    },
    "rxBin": {
      "@id": "coverage:rxBin",
      "@type": "xsd:string"
    },
    "rxPcn": {
      "@id": "coverage:rxPcn",
      "@type": "xsd:string"
    },
    "rxGroup": {
      "@id": "coverage:rxGroup",
      "@type": "xsd:string"
    }
  }
}
